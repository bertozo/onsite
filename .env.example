# Overrides for docker-compose.yml (the full containerized stack). Copy to .env and edit;
# docker compose reads .env from this directory automatically. None of these are required -
# the defaults in docker-compose.yml work out of the box for local use.

# Point at a real Supabase project so full sign-up/sign-in works end to end (this default is
# the same project the Android and web clients already talk to for local development).
SUPABASE_PROJECT_URL=https://bbxciadhznsdpdnwdynw.supabase.co

# Only signs/verifies the dev-only login's tokens (see DEV_AUTH_ENABLED) - any value works.
SUPABASE_JWT_SECRET=dev-only-secret-change-me

# Mints a session for any email, no password - never enable this against a real deployment.
DEV_AUTH_ENABLED=true

# Baked into the web app's static bundle at build time (see web/Dockerfile) - must be a URL
# the browser can reach, not the compose network's internal "backend" hostname.
WEB_BACKEND_URL=http://localhost:8080
