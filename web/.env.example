# Local backend (see ../backend/README.md to run it: docker compose up -d && ./gradlew run)
VITE_BACKEND_URL=http://localhost:8080

# Shows a "dev login" shortcut on the login screen that calls the backend's
# POST /v1/dev/auth/login (only works when the backend runs with DEV_AUTH_ENABLED=true).
# Leave unset/false against any backend that isn't your own local dev machine.
VITE_ENABLE_DEV_AUTH=true
