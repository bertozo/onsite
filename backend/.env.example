# Local development defaults matching docker-compose.yml.
DB_URL=jdbc:postgresql://localhost:5432/onsite
DB_USER=onsite
DB_PASSWORD=onsite_dev_only

# Real Supabase project URL (Settings > API in the Supabase dashboard). Tokens are
# verified against this project's public JWKS endpoint - no secret to copy.
SUPABASE_PROJECT_URL=https://your-project-ref.supabase.co

# Shared secret used only to mint/verify the dev-only login's tokens (see DEV_AUTH_ENABLED
# below) - unrelated to the real Supabase project, any value works locally.
SUPABASE_JWT_SECRET=dev-only-secret-change-me
SUPABASE_JWT_ISSUER=supabase

# Mints a session for any email, no password - see auth/DevAuthRoutes.kt. Never turn this
# on outside a local dev machine; leave unset (defaults to false) everywhere else.
DEV_AUTH_ENABLED=true

PORT=8080
